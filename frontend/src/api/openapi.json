{
  "openapi": "3.1.0",
  "info": {
    "title": "Wind Forecast Monitor API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "API health check",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Snapshot coverage and ingestion metadata",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/decision-snapshot": {
      "get": {
        "tags": [
          "decision"
        ],
        "summary": "Decision snapshot for one delivery day, with day KPIs",
        "operationId": "decision_snapshot_api_v1_decision_snapshot_get",
        "parameters": [
          {
            "name": "delivery_day",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "UK delivery day, YYYY-MM-DD, within the snapshot's delivery window.",
              "title": "Delivery Day"
            },
            "description": "UK delivery day, YYYY-MM-DD, within the snapshot's delivery window."
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "Decision cutoff as HH:MM UK time on the decision day (the day before).",
              "default": "09:20",
              "title": "Cutoff"
            },
            "description": "Decision cutoff as HH:MM UK time on the decision day (the day before)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionSnapshotResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid or out-of-range parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "description": "The body of an error response. ``errors`` lists each invalid parameter, if any.",
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "title": "Detail",
                      "type": "string"
                    },
                    "instance": {
                      "title": "Instance",
                      "type": "string"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status",
                    "detail",
                    "instance"
                  ],
                  "title": "ProblemDetail",
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "The data snapshot is not available",
            "content": {
              "application/problem+json": {
                "schema": {
                  "description": "The body of an error response. ``errors`` lists each invalid parameter, if any.",
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "title": "Detail",
                      "type": "string"
                    },
                    "instance": {
                      "title": "Instance",
                      "type": "string"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status",
                    "detail",
                    "instance"
                  ],
                  "title": "ProblemDetail",
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy": {
      "get": {
        "tags": [
          "accuracy"
        ],
        "summary": "Accuracy of decision forecasts over the scope, with an error histogram",
        "operationId": "accuracy_api_v1_accuracy_get",
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "Decision cutoff as HH:MM UK time on each decision day (the day before).",
              "default": "09:20",
              "title": "Cutoff"
            },
            "description": "Decision cutoff as HH:MM UK time on each decision day (the day before)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "description": "The body of an error response. ``errors`` lists each invalid parameter, if any.",
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "title": "Detail",
                      "type": "string"
                    },
                    "instance": {
                      "title": "Instance",
                      "type": "string"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status",
                    "detail",
                    "instance"
                  ],
                  "title": "ProblemDetail",
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "The data snapshot is not available",
            "content": {
              "application/problem+json": {
                "schema": {
                  "description": "The body of an error response. ``errors`` lists each invalid parameter, if any.",
                  "properties": {
                    "type": {
                      "default": "about:blank",
                      "title": "Type",
                      "type": "string"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "integer"
                    },
                    "detail": {
                      "title": "Detail",
                      "type": "string"
                    },
                    "instance": {
                      "title": "Instance",
                      "type": "string"
                    },
                    "errors": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Errors"
                    }
                  },
                  "required": [
                    "title",
                    "status",
                    "detail",
                    "instance"
                  ],
                  "title": "ProblemDetail",
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccuracyResponse": {
        "properties": {
          "cutoff": {
            "type": "string",
            "title": "Cutoff"
          },
          "delivery_days": {
            "$ref": "#/components/schemas/DeliveryDayRangeResponse"
          },
          "summary": {
            "$ref": "#/components/schemas/AccuracySummaryResponse"
          },
          "histogram": {
            "$ref": "#/components/schemas/ErrorHistogramResponse"
          },
          "band_coverage": {
            "$ref": "#/components/schemas/BandCoverageResponse"
          },
          "heatmap": {
            "$ref": "#/components/schemas/ErrorHeatmapResponse"
          },
          "worst_days": {
            "items": {
              "$ref": "#/components/schemas/WorstDayResponse"
            },
            "type": "array",
            "title": "Worst Days"
          },
          "horizon_curve": {
            "$ref": "#/components/schemas/HorizonCurveResponse"
          },
          "alignment_sensitivity": {
            "$ref": "#/components/schemas/AlignmentSensitivityResponse"
          }
        },
        "type": "object",
        "required": [
          "cutoff",
          "delivery_days",
          "summary",
          "histogram",
          "band_coverage",
          "heatmap",
          "worst_days",
          "horizon_curve",
          "alignment_sensitivity"
        ],
        "title": "AccuracyResponse"
      },
      "AccuracySummaryResponse": {
        "properties": {
          "target_hours": {
            "type": "integer",
            "title": "Target Hours"
          },
          "measured_hours": {
            "type": "integer",
            "title": "Measured Hours"
          },
          "excluded_no_decision_forecast": {
            "type": "integer",
            "title": "Excluded No Decision Forecast"
          },
          "excluded_no_actual": {
            "type": "integer",
            "title": "Excluded No Actual"
          },
          "mae_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mae Mw"
          },
          "bias_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bias Mw"
          },
          "rmse_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rmse Mw"
          },
          "p90_abs_error_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P90 Abs Error Mw"
          },
          "mean_actual_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Actual Mw"
          },
          "nmae_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nmae Percent"
          }
        },
        "type": "object",
        "required": [
          "target_hours",
          "measured_hours",
          "excluded_no_decision_forecast",
          "excluded_no_actual",
          "mae_mw",
          "bias_mw",
          "rmse_mw",
          "p90_abs_error_mw",
          "mean_actual_mw",
          "nmae_percent"
        ],
        "title": "AccuracySummaryResponse",
        "description": "Headline metrics over the measured hours, in MW unless stated. Metrics are null when no\nhour can be measured. Excluded hours are counted by reason, so the three counts add up to\n``target_hours``."
      },
      "ActualResponse": {
        "properties": {
          "target_time": {
            "type": "string",
            "format": "date-time",
            "title": "Target Time"
          },
          "generation_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Mw"
          }
        },
        "type": "object",
        "required": [
          "target_time",
          "generation_mw"
        ],
        "title": "ActualResponse"
      },
      "AlignmentMetricsResponse": {
        "properties": {
          "measured_hours": {
            "type": "integer",
            "title": "Measured Hours"
          },
          "mae_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mae Mw"
          },
          "bias_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bias Mw"
          },
          "rmse_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rmse Mw"
          }
        },
        "type": "object",
        "required": [
          "measured_hours",
          "mae_mw",
          "bias_mw",
          "rmse_mw"
        ],
        "title": "AlignmentMetricsResponse",
        "description": "Headline metrics under one alignment rule, in MW. Each side counts the hours its own rule can\nmeasure, so ``measured_hours`` can differ between the two. Metrics are null when none can be."
      },
      "AlignmentSensitivityResponse": {
        "properties": {
          "hourly_mean": {
            "$ref": "#/components/schemas/AlignmentMetricsResponse"
          },
          "top_of_hour": {
            "$ref": "#/components/schemas/AlignmentMetricsResponse"
          }
        },
        "type": "object",
        "required": [
          "hourly_mean",
          "top_of_hour"
        ],
        "title": "AlignmentSensitivityResponse",
        "description": "The headline metrics under the two alignment rules, over the same decision forecasts.\n\n``hourly_mean`` is the rule the headline figures use: the mean of the two half-hours of each\nhour. ``top_of_hour`` compares each hour with the half-hour starting at h:00 alone."
      },
      "BandCoverageResponse": {
        "properties": {
          "lookback_days": {
            "type": "integer",
            "title": "Lookback Days"
          },
          "min_history_days": {
            "type": "integer",
            "title": "Min History Days"
          },
          "counted_hours": {
            "type": "integer",
            "title": "Counted Hours"
          },
          "inside_hours": {
            "type": "integer",
            "title": "Inside Hours"
          },
          "coverage_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Percent"
          },
          "excluded_no_band": {
            "type": "integer",
            "title": "Excluded No Band"
          },
          "excluded_no_decision_forecast": {
            "type": "integer",
            "title": "Excluded No Decision Forecast"
          },
          "excluded_no_actual": {
            "type": "integer",
            "title": "Excluded No Actual"
          }
        },
        "type": "object",
        "required": [
          "lookback_days",
          "min_history_days",
          "counted_hours",
          "inside_hours",
          "coverage_percent",
          "excluded_no_band",
          "excluded_no_decision_forecast",
          "excluded_no_actual"
        ],
        "title": "BandCoverageResponse",
        "description": "How often the actual fell inside its expected-error band over the scope. Hours are counted\nwhen they have a decision forecast, an actual and a band. The four counts add up to\n``target_hours`` of the scope, and the coverage is null when no hour is counted."
      },
      "DecisionSnapshotResponse": {
        "properties": {
          "delivery_day": {
            "type": "string",
            "format": "date",
            "title": "Delivery Day"
          },
          "decision_day": {
            "type": "string",
            "format": "date",
            "title": "Decision Day"
          },
          "cutoff": {
            "type": "string",
            "title": "Cutoff"
          },
          "cutoff_time": {
            "type": "string",
            "format": "date-time",
            "title": "Cutoff Time"
          },
          "forecast_run_publish_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forecast Run Publish Time"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/HourResponse"
            },
            "type": "array",
            "title": "Hours"
          },
          "actuals": {
            "items": {
              "$ref": "#/components/schemas/ActualResponse"
            },
            "type": "array",
            "title": "Actuals"
          },
          "kpis": {
            "$ref": "#/components/schemas/KpisResponse"
          },
          "band": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectedErrorBandResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "delivery_day",
          "decision_day",
          "cutoff",
          "cutoff_time",
          "forecast_run_publish_time",
          "hours",
          "actuals",
          "kpis",
          "band"
        ],
        "title": "DecisionSnapshotResponse"
      },
      "DeliveryDayRangeResponse": {
        "properties": {
          "first": {
            "type": "string",
            "format": "date",
            "title": "First"
          },
          "last": {
            "type": "string",
            "format": "date",
            "title": "Last"
          }
        },
        "type": "object",
        "required": [
          "first",
          "last"
        ],
        "title": "DeliveryDayRangeResponse"
      },
      "DeliveryDaysResponse": {
        "properties": {
          "first": {
            "type": "string",
            "format": "date",
            "title": "First"
          },
          "last": {
            "type": "string",
            "format": "date",
            "title": "Last"
          }
        },
        "type": "object",
        "required": [
          "first",
          "last"
        ],
        "title": "DeliveryDaysResponse"
      },
      "ErrorBinResponse": {
        "properties": {
          "lower_mw": {
            "type": "number",
            "title": "Lower Mw"
          },
          "upper_mw": {
            "type": "number",
            "title": "Upper Mw"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "lower_mw",
          "upper_mw",
          "count"
        ],
        "title": "ErrorBinResponse",
        "description": "One bin: the lower edge is included and the upper edge excluded, except for the last bin."
      },
      "ErrorHeatmapResponse": {
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/HeatmapCellResponse"
            },
            "type": "array",
            "title": "Cells"
          }
        },
        "type": "object",
        "required": [
          "cells"
        ],
        "title": "ErrorHeatmapResponse"
      },
      "ErrorHistogramResponse": {
        "properties": {
          "bin_width_mw": {
            "type": "integer",
            "title": "Bin Width Mw"
          },
          "bins": {
            "items": {
              "$ref": "#/components/schemas/ErrorBinResponse"
            },
            "type": "array",
            "title": "Bins"
          }
        },
        "type": "object",
        "required": [
          "bin_width_mw",
          "bins"
        ],
        "title": "ErrorHistogramResponse"
      },
      "ExpectedErrorBandResponse": {
        "properties": {
          "lower_error_mw": {
            "type": "number",
            "title": "Lower Error Mw"
          },
          "upper_error_mw": {
            "type": "number",
            "title": "Upper Error Mw"
          },
          "history_days": {
            "type": "integer",
            "title": "History Days"
          }
        },
        "type": "object",
        "required": [
          "lower_error_mw",
          "upper_error_mw",
          "history_days"
        ],
        "title": "ExpectedErrorBandResponse",
        "description": "The band for the delivery day: P10 and P90 of the hourly decision-forecast errors (forecast\nminus actual, MW) over the 14 delivery days that end two days before it (D-15 to D-2), at the\nsame cutoff. A band needs at least 7 of those days with measured errors."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "HeatmapCellResponse": {
        "properties": {
          "delivery_day": {
            "type": "string",
            "format": "date",
            "title": "Delivery Day"
          },
          "hour": {
            "type": "integer",
            "title": "Hour"
          },
          "error_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Mw"
          }
        },
        "type": "object",
        "required": [
          "delivery_day",
          "hour",
          "error_mw"
        ],
        "title": "HeatmapCellResponse",
        "description": "The decision forecast error for one delivery day and one UK hour of day (0 to 23), in MW.\n``error_mw`` is null where that hour cannot be measured."
      },
      "HorizonBucketResponse": {
        "properties": {
          "lower_hours": {
            "type": "integer",
            "title": "Lower Hours"
          },
          "upper_hours": {
            "type": "integer",
            "title": "Upper Hours"
          },
          "mae_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mae Mw"
          },
          "bias_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bias Mw"
          },
          "sample_count": {
            "type": "integer",
            "title": "Sample Count"
          }
        },
        "type": "object",
        "required": [
          "lower_hours",
          "upper_hours",
          "mae_mw",
          "bias_mw",
          "sample_count"
        ],
        "title": "HorizonBucketResponse",
        "description": "Forecasts whose horizon is in (lower_hours, upper_hours]. MAE and bias are in MW and are null\nwhen the bucket has no measured forecast, in which case the sample count is zero."
      },
      "HorizonCurveResponse": {
        "properties": {
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/HorizonBucketResponse"
            },
            "type": "array",
            "title": "Buckets"
          },
          "excluded_no_actual": {
            "type": "integer",
            "title": "Excluded No Actual"
          },
          "decision_horizon_range_hours": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HorizonRangeResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "buckets",
          "excluded_no_actual",
          "decision_horizon_range_hours"
        ],
        "title": "HorizonCurveResponse",
        "description": "Error by forecast horizon over every forecast whose target time is in scope, not only the\ndecision forecasts. Buckets are 1 hour wide, from 1 hour up to the longest horizon in scope.\n``decision_horizon_range_hours`` is the shortest and longest horizon of the decision forecasts\nat the cutoff, so the curve can mark where the desk's decisions sit."
      },
      "HorizonRangeResponse": {
        "properties": {
          "min_hours": {
            "type": "number",
            "title": "Min Hours"
          },
