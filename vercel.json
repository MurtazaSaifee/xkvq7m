{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "",
  "buildCommand": "cd frontend && corepack pnpm install --frozen-lockfile && corepack pnpm build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,data/snapshot.duckdb}",
      "excludeFiles": "{.env*,.vercel/**,.claude/**,.scratch/**,.github/**,docs/**,frontend/**,backend/tests/**,backend/.venv/**}"
    }
  },
  "framework": "vite"
}
